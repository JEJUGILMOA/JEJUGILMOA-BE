{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(sh gradlew:*)",
      "Bash(gradlew.bat:*)",
      "PowerShell(./gradlew:*)",
      "PowerShell(.\\gradlew.bat:*)",
      "PowerShell(gradlew.bat:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec db:*)",
      "Bash(docker ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.dev)",
      "Read(.env.prod)"
    ]
  }
}
