# Spring
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL / PostGIS
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=1209600000
JWT_COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Tour API
TOUR_API_KEY=

# 외부 데이터 자동 동기화
APP_SYNC_RUN_ON_STARTUP=false

# OAuth - 사용하는 provider만 설정
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Visitor Data API - 현재 미구현
VISITOR_DATA_API_KEY=
VISITOR_DATA_BASE_URL=

# JVM
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
