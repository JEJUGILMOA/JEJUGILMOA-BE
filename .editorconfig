# 에디터/IDE/AI 도구 간 일관된 포맷을 강제한다.
# (IntelliJ, VS Code, Claude Code 모두 이 파일을 존중한다)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.gradle]
indent_size = 4

[gradlew.bat]
end_of_line = crlf
